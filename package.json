{
  "name": "picnic-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=26.5.1 <27"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:api": "wrangler dev --config apps/api/wrangler.jsonc",
    "dev:web": "vite --config apps/web/vite.config.mts",
    "build": "pnpm build:web && pnpm build:api",
    "build:api": "wrangler deploy --dry-run --config apps/api/wrangler.jsonc",
    "build:web": "vite build --config apps/web/vite.config.mts",
    "deploy:worker": "pnpm build:web && wrangler deploy --config apps/api/wrangler.jsonc",
    "auth-key": "node src/generate-auth-key.mjs",
    "smoke:api:auth": "node ./src/scripts/worker-auth-smoke.mjs",
    "lint": "eslint --cache --cache-location .eslintcache",
    "typecheck": "tsc --noEmit --pretty false",
    "validate": "pnpm lint && pnpm typecheck && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "hono": "4.12.33",
    "picnic-api": "4.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260731.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "17.4.2",
    "eslint": "10.8.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "wrangler": "4.117.0"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
